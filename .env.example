# Required Environment Variables for SGPJ Backend
# Copy this file to .env and fill in the actual values for your environment

# Database Configuration
DB_HOST=localhost
DB_NAME=sgpj
DB_USERNAME=app_sgpj
DB_PASSWORD=your_secure_database_password

# JWT Configuration
JWT_VALIDITY=3600
JWT_SECRET=your_secure_jwt_secret_key_at_least_256_bits

# Microsoft Graph API Configuration
CLIENT_ID=your_microsoft_app_client_id
CLIENT_SECRET=your_microsoft_app_client_secret
TENANT_ID=common
REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure

# DataJud API Configuration
DATAJUD_API_KEY=your_datajud_api_key

# Security Configuration
# Set to true in production to enforce secret validation
security.validate-secrets=true
